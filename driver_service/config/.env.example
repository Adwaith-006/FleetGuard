# AI Driver Drowsiness & Behaviour Safety Monitoring - Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Camera / Video Input
# Set to 0, 1, 2 for webcam index, or provide path to a prerecorded video file (e.g. data/driver_test.mp4)
VIDEO_SOURCE=0
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Driver & Vehicle Prototype Identifiers
DRIVER_ID=DRV001
VEHICLE_ID=VEH001
TIMEZONE=UTC

# Drowsiness Detection Thresholds
# EAR: Eye Aspect Ratio threshold (values below this indicate closed eyes; open ~0.24-0.30, closed ~0.05-0.10)
EAR_THRESHOLD=0.21
# Duration in seconds eyes must remain continuously closed to trigger drowsiness event
DROWSINESS_DURATION_THRESHOLD=1.5
# Maximum duration in seconds for a normal eye blink (distinguished from drowsiness)
BLINK_MAX_DURATION=0.4
# Cooldown period in seconds before another drowsiness event can be triggered
DROWSINESS_COOLDOWN=2.0

# Yawning Detection Thresholds
# MAR: Mouth Aspect Ratio (height / width) threshold (~0.15-0.35 talking, ~0.50+ yawning)
YAWN_MAR_THRESHOLD=0.50
# Duration in seconds mouth must remain open to confirm a yawn
YAWN_MIN_DURATION=2.0
# Cooldown period in seconds after a yawn before a new yawn event can start
YAWN_COOLDOWN=3.0

# Phone Detection Thresholds
# Set to False to completely disable phone detection
ENABLE_PHONE_DETECTION=True
PHONE_CONFIDENCE_THRESHOLD=0.45
PHONE_IOU_THRESHOLD=0.45
PHONE_DURATION_THRESHOLD=1.5
PHONE_COOLDOWN=3.0
YOLO_MODEL_PATH=driver_service/assets/yolov8n.pt

# Alarm Settings
ALARM_ENABLED=True
ALARM_SOUND_PATH=alarm.mp3
ALARM_VOLUME=1.0

# Backend Sync (Optional for driver-side standalone mode)
BACKEND_API_URL=http://localhost:8000/api/events
