# =====================================================================
# AI Driver Drowsiness & Behaviour Safety Monitoring - Environment Config
# =====================================================================
# Copy this file to .env and adjust variables as needed.

# ---------------------------------------------------------------------
# 1. Driver-Side Monitoring Service Settings
# ---------------------------------------------------------------------
# Camera / Video Input (0, 1, 2 for webcam index, or path to video file)
VIDEO_SOURCE=0
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Driver & Vehicle Prototype Identifiers
DRIVER_ID=DRV001
DRIVER_NAME=Prototype Driver (Demo Test)
VEHICLE_ID=VEH001
VEHICLE_NO=Cabin Rig
TIMEZONE=UTC

# Drowsiness Detection Thresholds (Geometric MediaPipe Face Mesh EAR)
EAR_THRESHOLD=0.21
DROWSINESS_DURATION_THRESHOLD=1.5
BLINK_MAX_DURATION=0.4
DROWSINESS_COOLDOWN=2.0

# Yawning Detection Thresholds (MAR: Mouth Aspect Ratio)
# Normal talking/smiling ~0.15-0.35; yawning ~0.50-0.75. Calibrated default: 0.50
YAWN_MAR_THRESHOLD=0.50
YAWN_MIN_DURATION=2.0
YAWN_COOLDOWN=3.0

# Phone Distraction Detection (YOLOv8 Object Detection)
ENABLE_PHONE_DETECTION=True
PHONE_CONFIDENCE_THRESHOLD=0.45
PHONE_IOU_THRESHOLD=0.45
PHONE_DURATION_THRESHOLD=1.5
PHONE_COOLDOWN=3.0
YOLO_MODEL_PATH=driver_service/assets/yolov8n.pt

# Posture / Head Down / Lay Down Detection (MediaPipe Head Pose Estimation)
ENABLE_POSTURE_DETECTION=True
HEAD_DOWN_DURATION_THRESHOLD=1.5
HEAD_DOWN_COOLDOWN=3.0
HEAD_PITCH_DOWN_THRESHOLD=-20.0
HEAD_ROLL_THRESHOLD=28.0
HEAD_SLUMP_Y_THRESHOLD=0.68

# Local In-Cabin Audio Alarm (Completely offline & independent)
ALARM_ENABLED=True
ALARM_SOUND_PATH=alarm.mp3
ALARM_VOLUME=1.0

# Driver-Side API Sync (Non-blocking background delivery with retry queue)
BACKEND_API_URL=http://127.0.0.1:8000/api/events

# ---------------------------------------------------------------------
# 2. Owner-Side Management Service Settings (FastAPI + MongoDB + Gemma)
# ---------------------------------------------------------------------
# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=driver_safety_db

# Local Ollama AI (Gemma)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=60.0

# FastAPI Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# React Frontend Dashboard (Vite)
FRONTEND_PORT=5173
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws
